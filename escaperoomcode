  <!-- FOOTER -->
  <footer class="bg-stadium-900 border-t border-stadium-800 py-3 text-center text-xs text-gray-500 no-print">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p>AP Statistics — Unit 2: Probability & Random Variables (Binomial Distributions)</p>
      <p class="font-mono">Desmos Binomial Challenge</p>
