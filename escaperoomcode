            <span>Instructor Signature</span>
          </div>
          <div>
            <span id="certDate">Date: November 2026</span>
          </div>
        </div>
      </div>

      <!-- Cert Action Buttons -->
      <div class="mt-6 flex justify-center space-x-4 no-print">
        <button onclick="window.print()" class="bg-turf-600 hover:bg-turf-700 text-white font-bold px-6 py-2.5 rounded-lg shadow-lg flex items-center space-x-2 transition">
          <i class="fa-solid fa-print"></i>
          <span>Print / Save PDF Certificate</span>
        </button>
      </div>

    </div>
