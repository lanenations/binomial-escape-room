  </main>

  <!-- FORMULA & DESMOS SIDE DRAWER MODAL -->
  <div id="formulaDrawer" class="fixed inset-0 z-50 overflow-hidden hidden" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm transition-opacity" id="closeFormulaBg"></div>

    <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10">
      <div class="pointer-events-auto w-screen max-w-md transform transition ease-in-out duration-300 bg-stadium-900 border-l border-stadium-700 text-gray-200 shadow-2xl flex flex-col">
        
        <!-- Drawer Header -->
        <div class="p-5 border-b border-stadium-700 bg-stadium-800 flex items-center justify-between">
          <div class="flex items-center space-x-2 text-turf-500">
            <i class="fa-solid fa-calculator text-lg"></i>
            <h2 class="text-base font-bold text-white uppercase tracking-wider">Desmos Binomial Toolkit</h2>
          </div>
          <button id="closeFormulaBtn" class="text-gray-400 hover:text-white p-2 rounded-lg hover:bg-stadium-700">
            <i class="fa-solid fa-xmark text-lg"></i>
          </button>
        </div>

        <!-- Drawer Content Body -->
        <div class="p-6 overflow-y-auto space-y-6 flex-1 text-sm">
          
          <!-- BINS Criteria Section -->
          <div class="bg-stadium-800 rounded-xl p-4 border border-stadium-700">
            <h3 class="text-xs font-bold uppercase tracking-wider text-turf-400 mb-2">B.I.N.S. Conditions for Binomial Setup</h3>
            <ul class="space-y-1.5 text-xs text-gray-300">
              <li><strong class="text-emerald-400">B - Binary:</strong> Outcomes are strictly Success ($S$) or Failure ($F$).</li>
              <li><strong class="text-emerald-400">I - Independent:</strong> Each trial is independent of all others.</li>
              <li><strong class="text-emerald-400">N - Number:</strong> The number of trials $n$ is fixed in advance.</li>
              <li><strong class="text-emerald-400">S - Same $p$:</strong> Probability of success $p$ remains constant.</li>
            </ul>
          </div>

          <!-- AP Formulas & Mean / SD -->
          <div class="bg-stadium-800 rounded-xl p-4 border border-stadium-700 space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-trophy-400">AP Stat Formulas & Desmos Summary</h3>
            
            <div class="p-2.5 bg-stadium-900 rounded-lg border border-stadium-700">
              <span class="text-xs font-semibold text-gray-400 block mb-1">Probability Function:</span>
              <div class="katex-math text-center py-1 text-emerald-400">P(X = k) = \binom{n}{k} p^k (1-p)^{n-k}</div>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div class="p-2.5 bg-stadium-900 rounded-lg border border-stadium-700 text-center">
                <span class="text-[11px] text-gray-400 block mb-1">Expected Value $\mu_X$</span>
                <div class="katex-math text-yellow-400 font-mono text-xs">\mu_X = n \cdot p</div>
                <span class="text-[10px] text-emerald-400 font-mono block mt-1">mean(binomdist(n,p))</span>
              </div>
              <div class="p-2.5 bg-stadium-900 rounded-lg border border-stadium-700 text-center">
                <span class="text-[11px] text-gray-400 block mb-1">Standard Dev $\sigma_X$</span>
                <div class="katex-math text-cyan-400 font-mono text-xs">\sigma_X = \sqrt{np(1-p)}</div>
                <span class="text-[10px] text-cyan-400 font-mono block mt-1">stdev(binomdist(n,p))</span>
              </div>
            </div>
          </div>

          <!-- Desmos Commands & Min/Max Guide -->
          <div class="bg-stadium-800 rounded-xl p-4 border border-stadium-700 space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-blue-400 flex items-center justify-between">
              <span>Desmos Graphing Calculator Syntax</span>
              <span class="text-[10px] bg-blue-900/60 text-blue-300 px-2 py-0.5 rounded">Desmos</span>
            </h3>
            
            <div class="p-2.5 bg-stadium-900 rounded-lg border border-stadium-700">
              <div class="font-mono text-emerald-400 font-bold text-xs mb-1">binomdist(n, p)</div>
              <p class="text-xs text-gray-300">Check <strong class="text-white">"Find Cumulative Probability"</strong> in Desmos to reveal Min and Max inputs:</p>
            </div>

            <div class="space-y-2 text-xs">
              <div class="p-2.5 bg-stadium-900 rounded-lg border border-stadium-700">
                <div class="flex justify-between items-center text-amber-400 font-semibold mb-1">
                  <span>Exact $P(X = k)$</span>
                  <code class="font-mono text-[11px] text-gray-300">Min: k | Max: k</code>
                </div>
                <p class="text-[11px] text-gray-400">Set both Min and Max to $k$.</p>
              </div>

              <div class="p-2.5 bg-stadium-900 rounded-lg border border-stadium-700">
                <div class="flex justify-between items-center text-emerald-400 font-semibold mb-1">
                  <span>At Least $P(X \ge k)$</span>
                  <code class="font-mono text-[11px] text-gray-300">Min: k | Max: n</code>
                </div>
                <p class="text-[11px] text-gray-400">Starts at $k$ and goes up to total trials $n$.</p>
              </div>

              <div class="p-2.5 bg-stadium-900 rounded-lg border border-stadium-700">
                <div class="flex justify-between items-center text-cyan-400 font-semibold mb-1">
                  <span>At Most $P(X \le k)$</span>
                  <code class="font-mono text-[11px] text-gray-300">Min: 0 | Max: k</code>
                </div>
                <p class="text-[11px] text-gray-400">Starts at $0$ up to $k$.</p>
              </div>

              <div class="p-2.5 bg-stadium-900 rounded-lg border border-stadium-700">
                <div class="flex justify-between items-center text-purple-400 font-semibold mb-1">
                  <span>Fewer Than $P(X < k)$</span>
                  <code class="font-mono text-[11px] text-gray-300">Min: 0 | Max: k - 1</code>
                </div>
                <p class="text-[11px] text-gray-400">Equivalent to $P(X \le k - 1)$.</p>
              </div>
            </div>
          </div>

          <!-- INTERACTIVE DESMOS WIDGET -->
          <div class="bg-stadium-800 rounded-xl p-4 border border-stadium-700 space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-purple-400 flex items-center justify-between">
              <span>Interactive Desmos Calculator Simulator</span>
              <span class="text-[10px] bg-purple-900/60 text-purple-300 px-2 py-0.5 rounded">Live Tool</span>
            </h3>
            
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="text-[10px] text-gray-400 block mb-1">Trials (n)</label>
                <input type="number" id="desmos-n" class="w-full bg-stadium-900 border border-stadium-600 rounded px-2.5 py-1.5 text-xs text-white font-mono" placeholder="10" value="10">
              </div>
              <div>
                <label class="text-[10px] text-gray-400 block mb-1">Probability (p)</label>
                <input type="number" step="0.01" id="desmos-p" class="w-full bg-stadium-900 border border-stadium-600 rounded px-2.5 py-1.5 text-xs text-white font-mono" placeholder="0.80" value="0.80">
              </div>
              <div>
                <label class="text-[10px] text-gray-400 block mb-1">Min Bounds</label>
                <input type="number" id="desmos-min" class="w-full bg-stadium-900 border border-stadium-600 rounded px-2.5 py-1.5 text-xs text-white font-mono" placeholder="8" value="8">
              </div>
              <div>
                <label class="text-[10px] text-gray-400 block mb-1">Max Bounds</label>
                <input type="number" id="desmos-max" class="w-full bg-stadium-900 border border-stadium-600 rounded px-2.5 py-1.5 text-xs text-white font-mono" placeholder="8" value="8">
              </div>
            </div>

            <button id="btnComputeDesmos" class="w-full bg-purple-700 hover:bg-purple-600 text-white rounded py-2 text-xs font-bold transition flex items-center justify-center space-x-1">
              <i class="fa-solid fa-calculator"></i>
              <span>Calculate in Desmos Syntax</span>
            </button>

            <div id="desmosOutput" class="p-3 bg-stadium-900 rounded-lg text-xs font-mono border border-purple-500/30 text-purple-300 space-y-1.5">
              <div class="text-[11px] text-gray-400">Desmos Command Preview:</div>
              <div class="text-emerald-400 font-bold" id="desmosCmdPreview">binomdist(10, 0.8)</div>
              <div class="flex justify-between border-t border-stadium-700 pt-1 text-gray-200">
                <span>Probability:</span>
                <span id="desmosProbResult" class="font-bold text-trophy-400">0.3020</span>
              </div>
              <div class="flex justify-between text-gray-400 text-[11px]">
                <span>Mean (μ): <strong id="desmosMeanResult" class="text-yellow-400">8.0</strong></span>
                <span>SD (σ): <strong id="desmosSdResult" class="text-cyan-400">1.2649</strong></span>
              </div>
            </div>

          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- CERTIFICATE PRINT MODAL -->
