  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap');
    
    body {
      background-color: #080C14;
      color: #F3F4F6;
      font-family: 'Inter', sans-serif;
