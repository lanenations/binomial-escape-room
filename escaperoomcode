              ?
            </div>
            <span class="text-[10px] text-gray-500 mt-1 uppercase">Rm 2</span>
          </div>
          <span class="text-gray-600 text-xl font-bold">-</span>
          <!-- Digit 3 -->
          <div class="flex flex-col items-center">
            <div id="digit-slot-3" class="w-10 h-14 sm:w-12 sm:h-16 rounded-xl bg-stadium-900 border-2 border-stadium-600 flex items-center justify-center text-2xl sm:text-3xl font-bold text-gray-500 transition-all duration-500 shadow-inner">
              ?
            </div>
            <span class="text-[10px] text-gray-500 mt-1 uppercase">Rm 3</span>
          </div>
          <span class="text-gray-600 text-xl font-bold">-</span>
          <!-- Digit 4 -->
          <div class="flex flex-col items-center">
            <div id="digit-slot-4" class="w-10 h-14 sm:w-12 sm:h-16 rounded-xl bg-stadium-900 border-2 border-stadium-600 flex items-center justify-center text-2xl sm:text-3xl font-bold text-gray-500 transition-all duration-500 shadow-inner">
              ?
            </div>
            <span class="text-[10px] text-gray-500 mt-1 uppercase">Rm 4</span>
          </div>
          <span class="text-gray-600 text-xl font-bold">-</span>
          <!-- Digit 5 -->
