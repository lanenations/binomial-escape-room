              </div>

              ${!isSolved ? `
                <button type="submit" class="bg-turf-600 hover:bg-turf-500 text-white font-bold px-8 py-3 rounded-xl transition flex items-center justify-center space-x-2 shadow-lg stadium-glow">
                  <i class="fa-solid fa-key"></i>
                  <span>Unlock Digit</span>
                </button>
              ` : `
                <button type="button" disabled class="bg-stadium-700 text-turf-400 font-bold px-8 py-3 rounded-xl flex items-center justify-center space-x-2 cursor-not-allowed">
                  <i class="fa-solid fa-lock-open"></i>
                  <span>Solved</span>
                </button>
              `}
            </form>

            <!-- Feedback Message Area -->
            <div id="feedback-${room.id}" class="hidden transition-all duration-300"></div>

            <!-- Hint Collapsible -->
            ${!isSolved ? `
              <div class="pt-2">
                <button type="button" onclick="toggleHint(${room.id})" class="text-xs text-gray-400 hover:text-trophy-400 flex items-center space-x-1.5 transition">
                  <i class="fa-regular fa-lightbulb text-trophy-400"></i>
                  <span>Need a hint?</span>
                </button>
                <div id="hintBox-${room.id}" class="hidden mt-2 p-3 bg-stadium-900 border border-trophy-500/30 rounded-lg text-xs text-trophy-300">
                  <i class="fa-solid fa-circle-info mr-1"></i> ${room.hint}
                </div>
              </div>
            ` : ''}
          </div>

          <!-- WORKED SOLUTION BOX (ONLY Auto-Reveals AFTER Correct Answer) -->
          ${isSolved ? `
            <div class="mt-8 border-t border-stadium-700 pt-6 animate-fadeIn">
              <div class="bg-stadium-900/90 border border-turf-500/40 rounded-2xl p-5 space-y-4">
                <div class="flex items-center justify-between border-b border-stadium-700 pb-3">
                  <div class="flex items-center space-x-2 text-turf-400 font-bold text-sm">
                    <i class="fa-solid fa-graduation-cap text-lg"></i>
                    <span>Official AP Statistics Solution & Verification</span>
                  </div>
                  <span class="text-[11px] bg-turf-500/20 text-turf-400 px-2 py-0.5 rounded font-mono">Digit Unlocked: ${room.digit}</span>
                </div>
                
                <div class="text-gray-200">
                  ${room.solution}
                </div>
              </div>
            </div>
          ` : ''}

          <!-- Room Navigation Controls -->
          <div class="flex items-center justify-between border-t border-stadium-700/60 pt-4 mt-6">
            <button 
              onclick="switchTab(${room.id > 1 ? room.id - 1 : 1})" 
              ${room.id === 1 ? 'disabled class="opacity-40 cursor-not-allowed text-gray-500 flex items-center space-x-1 text-xs font-semibold"' : 'class="text-gray-300 hover:text-white flex items-center space-x-1.5 text-xs font-semibold"'}>
              <i class="fa-solid fa-arrow-left"></i>
              <span>Previous Room</span>
            </button>

            <span class="text-xs text-gray-400 font-mono">Room ${room.id} of 6</span>

            <button 
              onclick="switchTab(${room.id < 6 ? room.id + 1 : 7})" 
              class="text-gray-300 hover:text-white flex items-center space-x-1.5 text-xs font-semibold">
              <span>${room.id === 6 ? 'Final Vault' : 'Next Room'}</span>
              <i class="fa-solid fa-arrow-right"></i>
            </button>
          </div>

        </div>
      `;

      // Render Math using KaTeX after updating DOM
      if (window.renderMathInElement) {
        setTimeout(() => {
          renderMathInElement(container, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '$', right: '$', display: false },
              { left: '\\(', right: '\\)', display: false },
              { left: '\\[', right: '\\]', display: true }
            ],
            throwOnError: false
          });
        }, 50);
      }
    }

    function renderVaultScreen(container) {
      container.innerHTML = `
        <div class="bg-stadium-800/90 border border-stadium-700 rounded-2xl p-6 sm:p-10 stadium-glow text-center space-y-8">
          
          <div class="max-w-md mx-auto space-y-3">
            <div class="w-20 h-20 mx-auto rounded-3xl ${state.vaultUnlocked ? 'bg-trophy-500/20 text-trophy-400 border-2 border-trophy-500 gold-glow' : 'bg-stadium-900 text-gray-500 border border-stadium-700'} flex items-center justify-center text-4xl transition-all duration-500">
              <i class="fa-solid ${state.vaultUnlocked ? 'fa-trophy' : 'fa-vault'}"></i>
            </div>
            <h2 class="text-2xl font-black text-white uppercase tracking-wider">Championship Vault Door</h2>
            <p class="text-xs text-gray-400">Enter the 6-digit vault passcode acquired from completing all 6 sports challenges.</p>
          </div>

          <!-- Interactive Passcode Keyboard -->
          <div class="max-w-sm mx-auto bg-stadium-900 p-6 rounded-2xl border border-stadium-700 shadow-2xl space-y-5">
            <div class="text-xs text-gray-400 font-semibold uppercase tracking-widest">6-Digit Keypad Input</div>
            
            <input 
              type="text" 
              id="vaultPasscodeInput" 
              maxlength="6"
              placeholder="------"
              value="${state.vaultUnlocked ? FULL_VAULT_CODE : ''}"
              class="w-full text-center text-3xl font-mono font-bold tracking-widest bg-stadium-800 border-2 border-stadium-600 focus:border-trophy-500 text-trophy-400 py-3 rounded-xl focus:outline-none shadow-inner"
            />

            <div class="grid grid-cols-3 gap-2 text-sm font-mono">
              ${[1,2,3,4,5,6,7,8,9,0].map(n => `
                <button onclick="appendVaultInput('${n}')" class="bg-stadium-800 hover:bg-stadium-700 text-white font-bold py-2.5 rounded-lg border border-stadium-700 active:scale-95 transition">${n}</button>
              `).join('')}
              <button onclick="clearVaultInput()" class="bg-red-900/40 hover:bg-red-800/60 text-red-300 font-bold py-2.5 rounded-lg border border-red-500/30 active:scale-95 transition">CLR</button>
            </div>

            <button 
              onclick="verifyVaultCode()" 
              class="w-full bg-gradient-to-r from-trophy-500 to-trophy-600 hover:from-trophy-400 hover:to-trophy-500 text-stadium-900 font-black py-3 rounded-xl text-base shadow-lg transition active:scale-95 uppercase tracking-wider"
            >
              <i class="fa-solid fa-lock-open mr-2"></i> Unlock Vault
            </button>
          </div>

          <!-- VICTORY RECAP SECTION -->
          <div id="victorySection" class="${state.vaultUnlocked ? 'block' : 'hidden'} mt-10 p-6 bg-stadium-900 border-2 border-trophy-500/60 rounded-2xl gold-glow space-y-6">
            <div class="space-y-2">
              <span class="px-3 py-1 rounded-full bg-trophy-500/20 text-trophy-400 text-xs font-bold uppercase tracking-wider border border-trophy-500/40">Championship Victory</span>
              <h3 class="text-3xl font-black text-white">CONGRATULATIONS!</h3>
              <p class="text-sm text-gray-300 max-w-lg mx-auto">You have unlocked the Championship Vault and mastered Binomial Distributions for AP Statistics!</p>
            </div>

            <!-- Stats Recap Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-lg mx-auto">
              <div class="bg-stadium-800 p-4 rounded-xl border border-stadium-700 text-center">
                <span class="text-[10px] text-gray-400 uppercase font-bold block mb-1">Total Time</span>
                <span class="text-xl font-bold font-mono text-emerald-400" id="finalTimeDisplay">--:--</span>
              </div>
              <div class="bg-stadium-800 p-4 rounded-xl border border-stadium-700 text-center">
                <span class="text-[10px] text-gray-400 uppercase font-bold block mb-1">Rooms Solved</span>
                <span class="text-xl font-bold font-mono text-trophy-400">6 / 6</span>
              </div>
              <div class="bg-stadium-800 p-4 rounded-xl border border-stadium-700 text-center">
                <span class="text-[10px] text-gray-400 uppercase font-bold block mb-1">Total Attempts</span>
                <span class="text-xl font-bold font-mono text-cyan-400" id="totalAttemptsDisplay">6</span>
              </div>
            </div>

            <button onclick="openCertificateModal()" class="bg-turf-600 hover:bg-turf-500 text-white font-bold px-8 py-3 rounded-xl shadow-xl transition stadium-glow inline-flex items-center space-x-2">
              <i class="fa-solid fa-award text-lg"></i>
              <span>View & Print Completion Certificate</span>
            </button>
          </div>

        </div>
      `;
    }

    // ==========================================
    // CONTROLLER & INTERACTION LOGIC
    // ==========================================
    function switchTab(tabId) {
      state.activeTab = tabId;
      renderTabs();
      renderRoomContent();
    }

    function toggleHint(roomId) {
      const hintBox = document.getElementById(`hintBox-${roomId}`);
      if (hintBox) {
        hintBox.classList.toggle('hidden');
      }
    }

    function handleAnswerSubmit(e, roomId) {
      e.preventDefault();
      const inputEl = document.getElementById(`roomInput-${roomId}`);
      const feedbackEl = document.getElementById(`feedback-${roomId}`);
      if (!inputEl || !feedbackEl) return;

      const rawVal = inputEl.value.trim();
      const room = ROOMS[roomId - 1];

      state.attempts[roomId - 1]++;
      state.userAnswers[roomId - 1] = rawVal;

      const isCorrect = room.acceptedAnswers.includes(rawVal);

      if (isCorrect) {
        state.solved[roomId - 1] = true;
        playSound('success');

        confetti({
          particleCount: 60,
          spread: 60,
          origin: { y: 0.7 }
        });

        feedbackEl.className = "p-4 bg-turf-500/20 border border-turf-500 rounded-xl text-turf-300 text-sm font-semibold flex items-center space-x-3";
        feedbackEl.innerHTML = `
          <i class="fa-solid fa-circle-check text-xl text-turf-400"></i>
          <div>
            <div>Correct! Vault Digit #${roomId} Unlocked: <strong class="text-trophy-400 text-lg font-mono">[ ${room.digit} ]</strong></div>
            <p class="text-xs text-gray-300 font-normal">Step-by-step AP solution revealed below.</p>
          </div>
        `;
        feedbackEl.classList.remove('hidden');

        renderTabs();
        renderVaultSlots();
        setTimeout(() => renderRoomContent(), 1200);

      } else {
        playSound('error');
        feedbackEl.className = "p-4 bg-red-950/60 border border-red-500/60 rounded-xl text-red-300 text-xs font-semibold flex items-center space-x-3";
        feedbackEl.innerHTML = `
          <i class="fa-solid fa-triangle-exclamation text-lg text-red-400"></i>
          <div>
            <div>Incorrect answer. Please try again!</div>
            <p class="text-gray-400 font-normal text-[11px] mt-0.5">Tip: Check decimal precision (e.g. 0.3020) and whether to use binomdist bounds in Desmos.</p>
          </div>
        `;
        feedbackEl.classList.remove('hidden');
      }
    }

    // Vault keypad logic
    function appendVaultInput(char) {
      const input = document.getElementById('vaultPasscodeInput');
      if (input && input.value.length < 6) {
        input.value += char;
      }
    }

    function clearVaultInput() {
      const input = document.getElementById('vaultPasscodeInput');
      if (input) input.value = '';
    }

    function verifyVaultCode() {
      const input = document.getElementById('vaultPasscodeInput');
      if (!input) return;

      const entered = input.value.trim();

      if (entered === FULL_VAULT_CODE) {
        state.vaultUnlocked = true;
        playSound('victory');

        const duration = 3 * 1000;
        const end = Date.now() + duration;

        (function frame() {
          confetti({
            particleCount: 5,
            angle: 60,
            spread: 55,
            origin: { x: 0 }
          });
          confetti({
            particleCount: 5,
            angle: 120,
            spread: 55,
            origin: { x: 1 }
          });

          if (Date.now() < end) {
            requestAnimationFrame(frame);
          }
        }());

        renderTabs();
        renderRoomContent();

        const elapsedSecs = (45 * 60) - state.timerSeconds;
        const mins = Math.floor(elapsedSecs / 60);
        const secs = elapsedSecs % 60;
        const formattedTime = `${mins}:${secs < 10 ? '0' : ''}${secs}`;

        const finalTimeEl = document.getElementById('finalTimeDisplay');
        if (finalTimeEl) finalTimeEl.innerText = formattedTime;

        const totalAttempts = state.attempts.reduce((a, b) => a + b, 0);
        const totalAttemptsEl = document.getElementById('totalAttemptsDisplay');
        if (totalAttemptsEl) totalAttemptsEl.innerText = totalAttempts;

      } else {
        playSound('error');
        alert("Incorrect passcode! Ensure all 6 digits are unlocked from Rooms 1 to 6.");
      }
    }

    // ==========================================
    // TIMER ENGINE
    // ==========================================
    function startTimer() {
      if (state.timerInterval) clearInterval(state.timerInterval);
      
      state.timerInterval = setInterval(() => {
        if (!state.timerRunning) return;

        if (state.timerSeconds > 0) {
          state.timerSeconds--;
          updateTimerDisplay();
        } else {
          clearInterval(state.timerInterval);
          alert("Time is up! Review your solved rooms and attempt the vault passcode.");
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const mins = Math.floor(state.timerSeconds / 60);
      const secs = state.timerSeconds % 60;
      const display = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
      
      const timerEl = document.getElementById('timerDisplay');
      const timerContainer = document.getElementById('timerContainer');
      if (timerEl) timerEl.innerText = display;

      if (state.timerSeconds < 5 * 60 && timerContainer) {
        timerContainer.classList.add('pulse-urgent', 'border-red-500');
        if (timerEl) timerEl.classList.replace('text-emerald-400', 'text-red-400');
      }
    }

    // ==========================================
    // MODAL & CERTIFICATE HANDLERS
    // ==========================================
    function openCertificateModal() {
      const name = prompt("Enter student / team name for certificate:", "AP Stat Champion");
      if (name) {
        document.getElementById('certStudentName').innerText = name;
      }
      
      const elapsedSecs = (45 * 60) - state.timerSeconds;
      const mins = Math.floor(elapsedSecs / 60);
      const secs = elapsedSecs % 60;
      document.getElementById('certTimeTaken').innerText = `${mins}m ${secs}s`;

      const now = new Date();
      document.getElementById('certDate').innerText = `Date: ${now.toLocaleDateString()}`;

      document.getElementById('certificateModal').classList.remove('hidden');
    }

    function initDesmosSimulator() {
      const computeBtn = document.getElementById('btnComputeDesmos');
      if (!computeBtn) return;

      computeBtn.addEventListener('click', () => {
        const n = parseInt(document.getElementById('desmos-n').value);
        const p = parseFloat(document.getElementById('desmos-p').value);
        const min = parseInt(document.getElementById('desmos-min').value);
        const max = parseInt(document.getElementById('desmos-max').value);

        if (isNaN(n) || isNaN(p) || isNaN(min) || isNaN(max)) return;

        let prob = 0;
        for (let k = min; k <= max; k++) {
          prob += binompdf(n, p, k);
        }

        const mean = n * p;
        const sd = Math.sqrt(n * p * (1 - p));

        document.getElementById('desmosCmdPreview').innerText = `binomdist(${n}, ${p}) [Min: ${min}, Max: ${max}]`;
        document.getElementById('desmosProbResult').innerText = prob.toFixed(4);
        document.getElementById('desmosMeanResult').innerText = mean.toFixed(2);
        document.getElementById('desmosSdResult').innerText = sd.toFixed(4);
        document.getElementById('desmosOutput').classList.remove('hidden');
      });
    }

    // ==========================================
    // INITIALIZATION & EVENT LISTENERS
    // ==========================================
    window.addEventListener('DOMContentLoaded', () => {
      renderTabs();
      renderVaultSlots();
      renderRoomContent();
      startTimer();
      initDesmosSimulator();

      // Timer Controls
      document.getElementById('toggleTimerBtn').addEventListener('click', () => {
        state.timerRunning = !state.timerRunning;
        const icon = document.getElementById('timerStateIcon');
        if (state.timerRunning) {
          icon.className = 'fa-solid fa-pause';
        } else {
          icon.className = 'fa-solid fa-play';
        }
      });

      document.getElementById('resetTimerBtn').addEventListener('click', () => {
        if (confirm("Reset countdown timer to 45:00?")) {
          state.timerSeconds = 45 * 60;
          updateTimerDisplay();
        }
      });

      // Sound Toggle
      document.getElementById('audioToggleBtn').addEventListener('click', () => {
        state.soundEnabled = !state.soundEnabled;
        const icon = document.getElementById('audioIcon');
        const text = document.getElementById('audioStatusText');

        if (state.soundEnabled) {
          icon.className = 'fa-solid fa-volume-high text-emerald-400';
          text.innerText = 'Sound ON';
        } else {
          icon.className = 'fa-solid fa-volume-xmark text-gray-500';
          text.innerText = 'Sound OFF';
        }
      });

      // Formula Drawer Toggles
      const drawer = document.getElementById('formulaDrawer');
      document.getElementById('openFormulaBtn').addEventListener('click', () => {
        drawer.classList.remove('hidden');
      });

      document.getElementById('closeFormulaBtn').addEventListener('click', () => {
        drawer.classList.add('hidden');
      });

      document.getElementById('closeFormulaBg').addEventListener('click', () => {
        drawer.classList.add('hidden');
      });

      // Certificate Modal Close
      document.getElementById('closeCertBtn').addEventListener('click', () => {
        document.getElementById('certificateModal').classList.add('hidden');
      });
    });
  </script>
</body>
</html>
